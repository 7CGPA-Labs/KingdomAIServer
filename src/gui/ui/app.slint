import { ScrollView } from "std-widgets.slint";
import { AntigravityTheme } from "theme.slint";
import { LeftSidebar, SessionItem, ProjectExplorerItem, ProjectConversationItem } from "sidebar.slint";
import { ChatCanvas, ChatMessage } from "chat_canvas.slint";
import { AuxiliaryPane, DiffLineItem, AuxTabItem } from "auxiliary_pane.slint";
import { ModelsHubView, ModelCardItem } from "models_hub.slint";
import { KTopDashboardView } from "ktop_panel.slint";
import { TasksPanel, ScheduledTaskItem } from "tasks_panel.slint";
import { SkillsPanel, SkillCardItem } from "skills_panel.slint";
import { ProjectsPanel, ProjectItem } from "projects_panel.slint";
import { SettingsModal } from "settings_modal.slint";
import { AntigravityIcon } from "components/icon.slint";

export struct PaletteItem {
    id: string,
    category: string,
    title: string,
    shortcut: string,
    icon-name: string,
}

component PaletteCommandRow inherits Rectangle {
    in-out property <string> category: "";
    in-out property <string> title: "";
    in-out property <string> shortcut: "";
    in-out property <string> icon-name: "search";
    callback clicked();

    height: 32px;
    border-radius: AntigravityTheme.radius-xs;
    background: row-ta.has-hover ? AntigravityTheme.background-surface-hover : transparent;

    row-ta := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            AntigravityIcon {
                name: root.icon-name;
                icon-size: 14px;
                icon-color: row-ta.has-hover ? AntigravityTheme.accent-blue : AntigravityTheme.text-secondary;
            }

            Rectangle {
                border-radius: 2px;
                background: AntigravityTheme.background-surface;
                height: 16px;

                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    Text {
                        text: root.category;
                        font-size: 9.5px;
                        font-weight: 600;
                        color: AntigravityTheme.text-muted;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: root.title;
                color: row-ta.has-hover ? AntigravityTheme.text-primary : AntigravityTheme.text-secondary;
                font-size: 12px;
                font-weight: 500;
                vertical-alignment: center;
            }
        }

        if root.shortcut != "": Rectangle {
            height: 18px;
            border-radius: 2px;
            background: AntigravityTheme.background-surface;

            HorizontalLayout {
                padding-left: 5px;
                padding-right: 5px;
                Text {
                    text: root.shortcut;
                    color: AntigravityTheme.text-muted;
                    font-size: 10px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Kingdom AI Studio";
    icon: @image-url("assets/icons/crown.svg");
    default-font-family: AntigravityTheme.font-family;
    default-font-size: AntigravityTheme.font-base;
    min-width: 1100px;
    min-height: 720px;
    preferred-width: 1300px;
    preferred-height: 860px;
    background: AntigravityTheme.background-canvas;

    // Frameless Window Control Callbacks
    callback close-requested();
    callback minimize-requested();
    callback maximize-requested();
    callback drag-window();

    // Navigation & View State
    in-out property <string> active-nav: "chat";
    in-out property <string> active-workspace: "KingdomAIServer";
    in-out property <string> conversation-title: "Active pair programming session";
    in-out property <string> active-conversation-id: "conv-1";
    in-out property <string> active-mode: "normal"; // "normal", "plan", "goal"
    in-out property <string> aux-active-tab: "council"; // "council" ("overview"), "diffs", "tasks", "process", "artifacts", "walkthrough"
    in-out property <bool> is-sidebar-collapsed: false;
    in-out property <bool> is-aux-collapsed: false;
    in-out property <bool> show-settings-modal: false;
    in-out property <string> open-menu: "";
    in-out property <bool> show-command-palette: false;
    in-out property <string> command-palette-query: "";
    in-out property <[PaletteItem]> palette-commands: [
        { id: "file-add-project", category: "File", title: "Add Projects / Open Folder...", shortcut: "Ctrl+O", icon-name: "folder" },
        { id: "file-new-conv", category: "File", title: "New Conversation", shortcut: "Ctrl+N", icon-name: "plus" },
        { id: "file-clear-chat", category: "File", title: "Clear Chat History", shortcut: "Ctrl+L", icon-name: "trash" },
        { id: "file-exit", category: "File", title: "Exit Kingdom AI Studio", shortcut: "Alt+F4", icon-name: "power" },
        { id: "view-toggle-sidebar", category: "View", title: "Toggle Left Projects Sidebar", shortcut: "Ctrl+B", icon-name: "sidebar" },
        { id: "view-toggle-aux", category: "View", title: "Toggle Right Auxiliary Panel", shortcut: "Ctrl+J", icon-name: "panel-right" },
        { id: "view-overview", category: "View", title: "Show Overview Dashboard", shortcut: "Overview", icon-name: "users" },
        { id: "view-tasks", category: "View", title: "Show Scheduled Tasks & Watchdog", shortcut: "Watchdog", icon-name: "terminal" },
        { id: "view-diffs", category: "View", title: "Show Git Diffs & Artifacts", shortcut: "Diffs", icon-name: "file-text" },
        { id: "view-telemetry", category: "View", title: "Show Silicon Telemetry (K-Top)", shortcut: "K-Top", icon-name: "cpu" },
        { id: "view-reset-layout", category: "View", title: "Reset Layout (Show All Panels)", shortcut: "", icon-name: "layout" },
        { id: "window-minimize", category: "Window", title: "Minimize Window", shortcut: "Win+Down", icon-name: "minus" },
        { id: "window-maximize", category: "Window", title: "Maximize / Restore Window", shortcut: "Win+Up", icon-name: "maximize" },
        { id: "studio-settings", category: "Studio", title: "Preferences & Hardware Settings", shortcut: "Ctrl+,", icon-name: "settings" },
        { id: "studio-models", category: "Studio", title: "Models Catalog Hub", shortcut: "/models", icon-name: "database" },
        { id: "studio-purge-cache", category: "Studio", title: "Purge LLM Response Cache", shortcut: "/clearcache", icon-name: "trash" },
        { id: "studio-reload-skills", category: "Studio", title: "Reload Customizations & Skills", shortcut: "/reload", icon-name: "refresh-cw" }
    ];

    // Hierarchical Project Tree & Dynamic Aux Tabs
    in-out property <[ProjectExplorerItem]> project-tree: [
        {
            id: "proj-1",
            name: "KingdomAIServer",
            path: "C:/Users/gagan/Projects/KingdomAIServer",
            is-expanded: true,
            is-active: true,
            conversations: [
                { id: "conv-1", title: "Active pair programming session", timestamp: "Active", is-active: true },
                { id: "conv-2", title: "Topbar & dynamic tabs migration", timestamp: "10m", is-active: false },
                { id: "conv-3", title: "VRAM watchdog & memory ceiling", timestamp: "2h", is-active: false },
                { id: "conv-4", title: "Tree-sitter AST intelligence", timestamp: "1d", is-active: false }
            ]
        },
        {
            id: "proj-2",
            name: "7CGPA-Labs-Core",
            path: "C:/Users/gagan/Projects/7CGPA-Labs-Core",
            is-expanded: true,
            is-active: false,
            conversations: [
                { id: "conv-5", title: "Semantic search embeddings", timestamp: "3d", is-active: false },
                { id: "conv-6", title: "Model quantization benchmarks", timestamp: "1w", is-active: false }
            ]
        },
        {
            id: "proj-3",
            name: "Cloud-Orchestrator",
            path: "C:/Users/gagan/Projects/Cloud-Orchestrator",
            is-expanded: false,
            is-active: false,
