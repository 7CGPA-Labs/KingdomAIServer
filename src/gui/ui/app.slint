    // Silicon & Model Telemetry
    in-out property <string> active-model: "Qwen 2.5 Coder 1.5B";
    in-out property <string> silicon-provider: "Vulkan / GPU Accelerated (Intel Iris Xe)";
    in-out property <string> vram-status: "2.14 / 6.00 GB";
