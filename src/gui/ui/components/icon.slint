import { AntigravityTheme } from "../theme.slint";

export component AntigravityIcon inherits Rectangle {
    in property <string> name: "";
    in property <color> icon-color: AntigravityTheme.text-secondary;
    in property <length> icon-size: 16px;

    width: root.icon-size;
    background: transparent;

    img-box := Rectangle {
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // Navigation & Layout
        if root.name == "sidebar": Image { source: @image-url("../assets/icons/sidebar.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "panel-right": Image { source: @image-url("../assets/icons/panel-right.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "chevron-left": Image { source: @image-url("../assets/icons/chevron-left.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "chevron-right": Image { source: @image-url("../assets/icons/chevron-right.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "chevron-down": Image { source: @image-url("../assets/icons/chevron-down.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "chevron-up": Image { source: @image-url("../assets/icons/chevron-up.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "more-vertical": Image { source: @image-url("../assets/icons/more-vertical.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "more-horizontal": Image { source: @image-url("../assets/icons/more-horizontal.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "close": Image { source: @image-url("../assets/icons/close.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "plus": Image { source: @image-url("../assets/icons/plus.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "check": Image { source: @image-url("../assets/icons/check.svg"); width: 100%; height: 100%; colorize: root.icon-color; }

        // Actions & Tools
        if root.name == "send": Image { source: @image-url("../assets/icons/send.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "stop": Image { source: @image-url("../assets/icons/stop.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "copy": Image { source: @image-url("../assets/icons/copy.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "edit": Image { source: @image-url("../assets/icons/edit.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "refresh": Image { source: @image-url("../assets/icons/refresh.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "search": Image { source: @image-url("../assets/icons/search.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "filter": Image { source: @image-url("../assets/icons/filter.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "play": Image { source: @image-url("../assets/icons/play.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "trash": Image { source: @image-url("../assets/icons/trash.svg"); width: 100%; height: 100%; colorize: root.icon-color; }

        // Domain & Studio Surfaces
        if root.name == "folder": Image { source: @image-url("../assets/icons/folder.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "history": Image { source: @image-url("../assets/icons/history.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "clock": Image { source: @image-url("../assets/icons/clock.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "message-square": Image { source: @image-url("../assets/icons/message-square.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "file-text": Image { source: @image-url("../assets/icons/file-text.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "diff": Image { source: @image-url("../assets/icons/diff.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "git-branch": Image { source: @image-url("../assets/icons/git-branch.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "settings": Image { source: @image-url("../assets/icons/settings.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "cpu": Image { source: @image-url("../assets/icons/cpu.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "box": Image { source: @image-url("../assets/icons/box.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "users": Image { source: @image-url("../assets/icons/users.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "puzzle": Image { source: @image-url("../assets/icons/puzzle.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "shield": Image { source: @image-url("../assets/icons/shield.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "palette": Image { source: @image-url("../assets/icons/palette.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "user": Image { source: @image-url("../assets/icons/user.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "sparkles": Image { source: @image-url("../assets/icons/sparkles.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "zap": Image { source: @image-url("../assets/icons/zap.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "info": Image { source: @image-url("../assets/icons/info.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "monitor": Image { source: @image-url("../assets/icons/monitor.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "terminal": Image { source: @image-url("../assets/icons/terminal.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "crown": Image { source: @image-url("../assets/icons/crown.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "minimize": Image { source: @image-url("../assets/icons/minimize.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "maximize": Image { source: @image-url("../assets/icons/maximize.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "download": Image { source: @image-url("../assets/icons/download.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "thumbs-up": Image { source: @image-url("../assets/icons/thumbs-up.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
        if root.name == "thumbs-down": Image { source: @image-url("../assets/icons/thumbs-down.svg"); width: 100%; height: 100%; colorize: root.icon-color; }
    }
}
