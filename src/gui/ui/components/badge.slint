import { AntigravityTheme } from "../theme.slint";

export component StatusBadge inherits Rectangle {
    in property <string> text: "ACTIVE";
    in property <color> badge-color: AntigravityTheme.status-success;

    border-radius: AntigravityTheme.radius-sm;
    background: badge-color.transparentize(85%);
    border-width: 1px;
    border-color: badge-color.transparentize(50%);
    height: 22px;

    HorizontalLayout {
        padding-left: AntigravityTheme.spacing-sm;
        padding-right: AntigravityTheme.spacing-sm;
        spacing: AntigravityTheme.spacing-xs;
        alignment: center;

        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.badge-color;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            color: root.badge-color;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}
