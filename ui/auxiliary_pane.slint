import { AntigravityTheme } from "theme.slint";
import { StatusBadge } from "components/badge.slint";
import { ProgressMeter } from "components/progress_meter.slint";

export struct DiffLineItem {
    line-number: int,
    prefix: string, // "+", "-", " "
    content: string,
}

export component AuxiliaryPane inherits Rectangle {
    in-out property <string> active-tab: "council"; // "council", "tasks", "artifacts", "diffs", "telemetry"

    // Council stats
    in property <string> boss-name: "Qwen 2.5 Coder 1.5B";
    in property <string> boss-status: "ACTIVE";
    in property <string> m1-status: "ACTIVE";
    in property <string> m2-status: "ACTIVE";
    in property <string> ast-status: "READY";

    // Tasks & Subagents stats
    in property <string> worker-state: "Idle";
    in property <int> active-subagents-count: 0;

    // Artifacts stats
    in property <string> artifact-title: "Stage 2 Antigravity 2.0 Plan";
    in property <string> artifact-summary: "Implement pixel-to-pixel Antigravity 2.0 desktop layout with Slint zero-server runtime.";

    // Diffs stats
    in property <string> diff-file: "ui/app.slint";
    in property <[DiffLineItem]> diff-lines: [
        { line-number: 14, prefix: " ", content: "    min-width: 1100px;" },
        { line-number: 15, prefix: "-", content: "    // Legacy single tab inspector" },
        { line-number: 15, prefix: "+", content: "    // Antigravity 2.0 5-Tab Auxiliary Inspector" },
        { line-number: 16, prefix: "+", content: "    AuxiliaryPane {" },
        { line-number: 17, prefix: "+", content: "        active-tab: root.aux-tab;" },
        { line-number: 18, prefix: " ", content: "    }" }
    ];

    // Telemetry stats
    in property <float> cpu-progress: 0.25;
    in property <string> cpu-text: "25.0%";
    in property <float> ram-progress: 0.36;
    in property <string> ram-text: "5.8 / 16.0 GB";
    in property <float> vram-progress: 0.35;
    in property <string> vram-text: "2.14 / 6.00 GB";
    in property <float> speed-tokens-sec: 34.5;

    // Cache stats
    in property <int> cache-entries: 142;
    in property <int> cache-hits: 28;
    in property <float> cache-hit-ratio: 68.5;

    callback tab-changed(string);
    callback purge-cache-clicked();

    width: 320px;
    background: AntigravityTheme.background-surface;

    VerticalLayout {
        padding: AntigravityTheme.spacing-md;
        spacing: AntigravityTheme.spacing-md;

        // 5-Tab Switcher Bar (Antigravity 2.0 Inspector Tabs)
        Rectangle {
            height: 34px;
            background: AntigravityTheme.background-input;
            border-radius: AntigravityTheme.radius-sm;

            HorizontalLayout {
                padding: 2px;
                spacing: 2px;

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: AntigravityTheme.radius-sm;
                    background: root.active-tab == "council" ? AntigravityTheme.background-active : transparent;
                    TouchArea { clicked => { root.active-tab = "council"; root.tab-changed("council"); } }
                    Text {
                        text: "🏛️";
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: AntigravityTheme.radius-sm;
                    background: root.active-tab == "tasks" ? AntigravityTheme.background-active : transparent;
                    TouchArea { clicked => { root.active-tab = "tasks"; root.tab-changed("tasks"); } }
                    Text {
                        text: "⏱️";
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: AntigravityTheme.radius-sm;
                    background: root.active-tab == "artifacts" ? AntigravityTheme.background-active : transparent;
                    TouchArea { clicked => { root.active-tab = "artifacts"; root.tab-changed("artifacts"); } }
                    Text {
                        text: "📑";
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: AntigravityTheme.radius-sm;
                    background: root.active-tab == "diffs" ? AntigravityTheme.background-active : transparent;
                    TouchArea { clicked => { root.active-tab = "diffs"; root.tab-changed("diffs"); } }
                    Text {
                        text: "🔄";
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: AntigravityTheme.radius-sm;
                    background: root.active-tab == "telemetry" ? AntigravityTheme.background-active : transparent;
                    TouchArea { clicked => { root.active-tab = "telemetry"; root.tab-changed("telemetry"); } }
                    Text {
                        text: "📊";
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // TAB 1: Council Ministers View
        if root.active-tab == "council": VerticalLayout {
            spacing: AntigravityTheme.spacing-sm;

            Text {
                text: "LEAN COUNCIL ARCHITECTURE";
                color: AntigravityTheme.text-muted;
                font-size: 10px;
                font-weight: 700;
            }

            Rectangle {
                height: 58px;
                background: AntigravityTheme.background-input;
                border-radius: AntigravityTheme.radius-sm;
                border-width: 1px;
                border-color: AntigravityTheme.border-subtle;

                HorizontalLayout {
                    padding: AntigravityTheme.spacing-sm;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: "Boss LLM (Active)"; color: AntigravityTheme.accent-magenta; font-size: 12px; font-weight: 700; }
                        Text { text: root.boss-name; color: AntigravityTheme.text-secondary; font-size: 11px; }
                    }

                    StatusBadge {
                        text: root.boss-status;
                        badge-color: root.boss-status == "ACTIVE" ? AntigravityTheme.status-success : AntigravityTheme.status-warning;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            Rectangle {
                height: 52px;
                background: AntigravityTheme.background-input;
                border-radius: AntigravityTheme.radius-sm;
                border-width: 1px;
                border-color: AntigravityTheme.border-subtle;

                HorizontalLayout {
                    padding: AntigravityTheme.spacing-sm;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: "Minister 1: BGE Embedder"; color: AntigravityTheme.text-primary; font-size: 12px; font-weight: 700; }
                        Text { text: "384-d Vector Generator (35 MB)"; color: AntigravityTheme.text-muted; font-size: 10px; }
                    }

                    StatusBadge {
                        text: root.m1-status;
                        badge-color: root.m1-status == "ACTIVE" ? AntigravityTheme.status-success : AntigravityTheme.text-muted;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            Rectangle {
                height: 52px;
                background: AntigravityTheme.background-input;
                border-radius: AntigravityTheme.radius-sm;
                border-width: 1px;
                border-color: AntigravityTheme.border-subtle;

                HorizontalLayout {
                    padding: AntigravityTheme.spacing-sm;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: "Minister 2: BGE Reranker"; color: AntigravityTheme.text-primary; font-size: 12px; font-weight: 700; }
                        Text { text: "Context Ranker (110 MB)"; color: AntigravityTheme.text-muted; font-size: 10px; }
                    }

                    StatusBadge {
                        text: root.m2-status;
                        badge-color: root.m2-status == "ACTIVE" ? AntigravityTheme.status-success : AntigravityTheme.status-warning;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            Rectangle {
                height: 52px;
                background: AntigravityTheme.background-input;
                border-radius: AntigravityTheme.radius-sm;
                border-width: 1px;
                border-color: AntigravityTheme.border-subtle;

                HorizontalLayout {
                    padding: AntigravityTheme.spacing-sm;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: "Native AST Tree-sitter"; color: AntigravityTheme.text-primary; font-size: 12px; font-weight: 700; }
                        Text { text: "Structural Code Parser (<1ms)"; color: AntigravityTheme.text-muted; font-size: 10px; }
                    }

                    StatusBadge {
                        text: root.ast-status;
                        badge-color: AntigravityTheme.status-success;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }

        // TAB 2: Subagents & Background Workers
        if root.active-tab == "tasks": VerticalLayout {
            spacing: AntigravityTheme.spacing-sm;

            Text {
                text: "SUBAGENTS & WORKER THREADS";
                color: AntigravityTheme.text-muted;
                font-size: 10px;
                font-weight: 700;
            }

            Rectangle {
                height: 54px;
                background: AntigravityTheme.background-input;
                border-radius: AntigravityTheme.radius-sm;
                border-width: 1px;
                border-color: AntigravityTheme.border-subtle;

                HorizontalLayout {
                    padding: AntigravityTheme.spacing-sm;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: "Inference Worker"; color: AntigravityTheme.text-primary; font-size: 12px; font-weight: 700; }
                        Text { text: "Dedicated thread execution"; color: AntigravityTheme.text-muted; font-size: 10px; }
                    }

                    StatusBadge {
                        text: root.worker-state;
                        badge-color: root.worker-state == "Generating" ? AntigravityTheme.accent-cyan : AntigravityTheme.text-muted;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            Rectangle {
                height: 54px;
                background: AntigravityTheme.background-input;
                border-radius: AntigravityTheme.radius-sm;
                border-width: 1px;
                border-color: AntigravityTheme.border-subtle;

                HorizontalLayout {
                    padding: AntigravityTheme.spacing-sm;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: "Telemetry Poller"; color: AntigravityTheme.text-primary; font-size: 12px; font-weight: 700; }
                        Text { text: "500ms hardware heartbeat"; color: AntigravityTheme.text-muted; font-size: 10px; }
                    }

                    StatusBadge {
                        text: "POLLING";
                        badge-color: AntigravityTheme.status-success;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            Rectangle {
                height: 54px;
                background: AntigravityTheme.background-input;
                border-radius: AntigravityTheme.radius-sm;
                border-width: 1px;
                border-color: AntigravityTheme.border-subtle;

                HorizontalLayout {
                    padding: AntigravityTheme.spacing-sm;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: "Subagent Supervisor"; color: AntigravityTheme.text-primary; font-size: 12px; font-weight: 700; }
                        Text { text: root.active-subagents-count + " subagents active"; color: AntigravityTheme.text-muted; font-size: 10px; }
                    }

                    StatusBadge {
                        text: "STANDBY";
                        badge-color: AntigravityTheme.text-muted;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }

        // TAB 3: Artifacts & Plans View
        if root.active-tab == "artifacts": VerticalLayout {
            spacing: AntigravityTheme.spacing-sm;

            Text {
                text: "ACTIVE PLAN & ARTIFACTS";
                color: AntigravityTheme.text-muted;
                font-size: 10px;
                font-weight: 700;
            }

            Rectangle {
                background: AntigravityTheme.background-input;
                border-radius: AntigravityTheme.radius-sm;
                border-width: 1px;
                border-color: AntigravityTheme.border-subtle;

                VerticalLayout {
                    padding: AntigravityTheme.spacing-md;
                    spacing: AntigravityTheme.spacing-sm;

                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "📄 " + root.artifact-title; color: AntigravityTheme.accent-cyan; font-size: 12px; font-weight: 700; }
                        StatusBadge { text: "APPROVED"; badge-color: AntigravityTheme.status-success; }
                    }

                    Text {
                        text: root.artifact-summary;
                        color: AntigravityTheme.text-secondary;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    Rectangle { height: 1px; background: AntigravityTheme.border-subtle; }

                    Text { text: "1. 100% In-process Zero-Server Slint architecture"; color: AntigravityTheme.text-primary; font-size: 11px; }
                    Text { text: "2. Strictly enforce VRAM <= 6.00 GB ceiling"; color: AntigravityTheme.text-primary; font-size: 11px; }
                    Text { text: "3. Pixel-to-pixel Antigravity 2.0 design parity"; color: AntigravityTheme.text-primary; font-size: 11px; }
                    Text { text: "4. Unified Diff & Artifact inspection engine"; color: AntigravityTheme.text-primary; font-size: 11px; }
                }
            }
        }

        // TAB 4: Code Diffs Viewer
        if root.active-tab == "diffs": VerticalLayout {
            spacing: AntigravityTheme.spacing-sm;

            HorizontalLayout {
                alignment: space-between;
                Text { text: "UNIFIED FILE DIFF"; color: AntigravityTheme.text-muted; font-size: 10px; font-weight: 700; }
                Text { text: root.diff-file; color: AntigravityTheme.accent-cyan; font-size: 10px; font-weight: 700; }
            }

            Rectangle {
                background: AntigravityTheme.background-input;
                border-radius: AntigravityTheme.radius-sm;
                border-width: 1px;
                border-color: AntigravityTheme.border-subtle;
                clip: true;

                VerticalLayout {
                    padding: AntigravityTheme.spacing-xs;
                    spacing: 2px;

                    for line in root.diff-lines: Rectangle {
                        height: 22px;
                        background: line.prefix == "+" ? #22c55e.transparentize(85%) : (line.prefix == "-" ? #ef4444.transparentize(85%) : transparent);
                        border-radius: 2px;

                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 6px;

                            Text {
                                text: line.line-number;
                                color: AntigravityTheme.text-muted;
                                font-size: 10px;
                                font-family: "Consolas, 'Courier New', monospace";
                                width: 24px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }

                            Text {
                                text: line.prefix;
                                color: line.prefix == "+" ? AntigravityTheme.status-success : (line.prefix == "-" ? AntigravityTheme.status-error : AntigravityTheme.text-muted);
                                font-size: 11px;
                                font-weight: 700;
                                font-family: "Consolas, 'Courier New', monospace";
                                width: 10px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: line.content;
                                color: line.prefix == "+" ? #86efac : (line.prefix == "-" ? #fca5a5 : AntigravityTheme.text-primary);
                                font-size: 11px;
                                font-family: "Consolas, 'Courier New', monospace";
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }

        // TAB 5: K-Top Telemetry & Cache View
        if root.active-tab == "telemetry": VerticalLayout {
            spacing: AntigravityTheme.spacing-md;

            Text {
                text: "SILICON & RESOURCE GAUGES";
                color: AntigravityTheme.text-muted;
                font-size: 10px;
                font-weight: 700;
            }

            Rectangle {
                background: AntigravityTheme.background-input;
                border-radius: AntigravityTheme.radius-sm;
                border-width: 1px;
                border-color: AntigravityTheme.border-subtle;

                VerticalLayout {
                    padding: AntigravityTheme.spacing-md;
                    spacing: AntigravityTheme.spacing-sm;

                    ProgressMeter {
                        label: "CPU";
                        progress: root.cpu-progress;
                        value-text: root.cpu-text;
                        bar-color: AntigravityTheme.accent-cyan;
                    }

                    ProgressMeter {
                        label: "RAM";
                        progress: root.ram-progress;
                        value-text: root.ram-text;
                        bar-color: AntigravityTheme.accent-magenta;
                    }

                    ProgressMeter {
                        label: "VRAM";
                        progress: root.vram-progress;
                        value-text: root.vram-text;
                        bar-color: AntigravityTheme.status-success;
                    }
                }
            }

            Rectangle {
                height: 40px;
                background: AntigravityTheme.background-input;
                border-radius: AntigravityTheme.radius-sm;
                border-width: 1px;
                border-color: AntigravityTheme.border-subtle;

                HorizontalLayout {
                    padding-left: AntigravityTheme.spacing-md;
                    padding-right: AntigravityTheme.spacing-md;
                    alignment: space-between;

                    Text { text: "⚡ Generation Throughput"; color: AntigravityTheme.text-secondary; font-size: 12px; vertical-alignment: center; }
                    Text { text: Math.round(root.speed-tokens-sec) + " tok/s"; color: AntigravityTheme.status-success; font-size: 13px; font-weight: 800; vertical-alignment: center; }
                }
            }

            Rectangle {
                background: AntigravityTheme.background-input;
                border-radius: AntigravityTheme.radius-sm;
                border-width: 1px;
                border-color: AntigravityTheme.border-subtle;

                VerticalLayout {
                    padding: AntigravityTheme.spacing-md;
                    spacing: AntigravityTheme.spacing-xs;

                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Cache Entries"; color: AntigravityTheme.text-secondary; font-size: 11px; }
                        Text { text: root.cache-entries + " entries"; color: AntigravityTheme.text-primary; font-size: 11px; font-weight: 700; }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Cache Hits"; color: AntigravityTheme.text-secondary; font-size: 11px; }
                        Text { text: root.cache-hits + " hits (" + Math.round(root.cache-hit-ratio) + "%)"; color: AntigravityTheme.accent-cyan; font-size: 11px; font-weight: 700; }
                    }
                }
            }

            Rectangle {
                height: 32px;
                border-radius: AntigravityTheme.radius-sm;
                background: purge-touch.has-hover ? AntigravityTheme.status-error : AntigravityTheme.background-input;
                border-width: 1px;
                border-color: AntigravityTheme.status-error;

                purge-touch := TouchArea {
                    clicked => { root.purge-cache-clicked(); }
                }

                Text {
                    text: "Purge Response Cache";
                    color: purge-touch.has-hover ? #ffffff : AntigravityTheme.status-error;
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
