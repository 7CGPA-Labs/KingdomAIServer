import { AntigravityTheme } from "theme.slint";
import { StatusBadge } from "components/badge.slint";

export struct SessionItem {
    id: string,
    title: string,
    timestamp: string,
}

export component LeftSidebar inherits Rectangle {
    in property <string> active-nav: "chat";
    in property <string> active-workspace: "KingdomAIServer";
    in property <[SessionItem]> sessions: [
        { id: "1", title: "Active pair programming session", timestamp: "Active" },
        { id: "2", title: "Refactor telemetry meters", timestamp: "Today" },
        { id: "3", title: "Add Intel Iris Xe Vulkan wheel", timestamp: "Yesterday" }
    ];

    callback nav-selected(string);
    callback new-chat-clicked();
    callback select-workspace-clicked();
    callback session-selected(string);

    width: 260px;
    background: AntigravityTheme.background-surface;

    VerticalLayout {
        padding: AntigravityTheme.spacing-md;
        spacing: AntigravityTheme.spacing-md;

        // Top Brand Header (Antigravity 2.0 Brand & New Chat)
        HorizontalLayout {
            spacing: AntigravityTheme.spacing-sm;
            alignment: space-between;

            HorizontalLayout {
                spacing: AntigravityTheme.spacing-xs;
                alignment: center;

                Text {
                    text: "👑";
                    font-size: 18px;
                    vertical-alignment: center;
                }

                Text {
                    text: "Kingdom";
                    color: AntigravityTheme.text-primary;
                    font-size: 15px;
                    font-weight: 800;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 32px;
                    height: 18px;
                    border-radius: 9px;
                    background: AntigravityTheme.accent-cyan.transparentize(80%);
                    border-width: 1px;
                    border-color: AntigravityTheme.accent-cyan.transparentize(50%);
                    y: (parent.height - self.height) / 2;

                    Text {
                        text: "2.0";
                        color: AntigravityTheme.accent-cyan;
                        font-size: 9px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: AntigravityTheme.radius-sm;
                background: new-touch.has-hover ? AntigravityTheme.background-surface-hover : AntigravityTheme.background-input;
                border-width: 1px;
                border-color: AntigravityTheme.border-subtle;

                new-touch := TouchArea {
                    clicked => { root.new-chat-clicked(); }
                }

                Text {
                    text: "+";
                    color: AntigravityTheme.accent-cyan;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Active Workspace Card
        Rectangle {
            height: 52px;
            border-radius: AntigravityTheme.radius-sm;
            background: ws-touch.has-hover ? AntigravityTheme.background-surface-hover : AntigravityTheme.background-input;
            border-width: 1px;
            border-color: AntigravityTheme.border-subtle;

            ws-touch := TouchArea {
                clicked => { root.select-workspace-clicked(); }
            }

            VerticalLayout {
                padding-left: AntigravityTheme.spacing-sm;
                padding-right: AntigravityTheme.spacing-sm;
                alignment: center;
                spacing: 2px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "ACTIVE WORKSPACE";
                        color: AntigravityTheme.text-muted;
                        font-size: 9px;
                        font-weight: 700;
                    }
                    Text {
                        text: "📁 switch";
                        color: AntigravityTheme.text-muted;
                        font-size: 9px;
                    }
                }

                Text {
                    text: root.active-workspace;
                    color: AntigravityTheme.accent-cyan;
                    font-size: 12px;
                    font-weight: 700;
                    overflow: elide;
                }
            }
        }

        // Navigation Menu (Antigravity 2.0 Suite)
        VerticalLayout {
            spacing: 2px;

            // 1. Chat Tab
            Rectangle {
                height: 34px;
                border-radius: AntigravityTheme.radius-sm;
                background: root.active-nav == "chat" ? AntigravityTheme.background-active : (chat-touch.has-hover ? AntigravityTheme.background-surface-hover : transparent);

                chat-touch := TouchArea {
                    clicked => { root.nav-selected("chat"); }
                }

                HorizontalLayout {
                    padding-left: AntigravityTheme.spacing-sm;
                    padding-right: AntigravityTheme.spacing-sm;
                    spacing: AntigravityTheme.spacing-sm;
                    alignment: start;

                    Text { text: "💬"; font-size: 13px; vertical-alignment: center; }
                    Text {
                        text: "Chat & Canvas";
                        color: root.active-nav == "chat" ? AntigravityTheme.text-primary : AntigravityTheme.text-secondary;
                        font-size: 12px;
                        font-weight: root.active-nav == "chat" ? 700 : 500;
                        vertical-alignment: center;
                    }
                }
            }

            // 2. Projects Tab
            Rectangle {
                height: 34px;
                border-radius: AntigravityTheme.radius-sm;
                background: root.active-nav == "projects" ? AntigravityTheme.background-active : (projects-touch.has-hover ? AntigravityTheme.background-surface-hover : transparent);

                projects-touch := TouchArea {
                    clicked => { root.nav-selected("projects"); }
                }

                HorizontalLayout {
                    padding-left: AntigravityTheme.spacing-sm;
                    padding-right: AntigravityTheme.spacing-sm;
                    spacing: AntigravityTheme.spacing-sm;
                    alignment: start;

                    Text { text: "📁"; font-size: 13px; vertical-alignment: center; }
                    Text {
                        text: "Projects & Repos";
                        color: root.active-nav == "projects" ? AntigravityTheme.text-primary : AntigravityTheme.text-secondary;
                        font-size: 12px;
                        font-weight: root.active-nav == "projects" ? 700 : 500;
                        vertical-alignment: center;
                    }
                }
            }

            // 3. Scheduled Tasks Tab
            Rectangle {
                height: 34px;
                border-radius: AntigravityTheme.radius-sm;
                background: root.active-nav == "tasks" ? AntigravityTheme.background-active : (tasks-touch.has-hover ? AntigravityTheme.background-surface-hover : transparent);

                tasks-touch := TouchArea {
                    clicked => { root.nav-selected("tasks"); }
                }

                HorizontalLayout {
                    padding-left: AntigravityTheme.spacing-sm;
                    padding-right: AntigravityTheme.spacing-sm;
                    spacing: AntigravityTheme.spacing-sm;
                    alignment: start;

                    Text { text: "⏱️"; font-size: 13px; vertical-alignment: center; }
                    Text {
                        text: "Scheduled Tasks";
                        color: root.active-nav == "tasks" ? AntigravityTheme.text-primary : AntigravityTheme.text-secondary;
                        font-size: 12px;
                        font-weight: root.active-nav == "tasks" ? 700 : 500;
                        vertical-alignment: center;
                    }
                }
            }

            // 4. Skills & Customizations Tab
            Rectangle {
                height: 34px;
                border-radius: AntigravityTheme.radius-sm;
                background: root.active-nav == "skills" ? AntigravityTheme.background-active : (skills-touch.has-hover ? AntigravityTheme.background-surface-hover : transparent);

                skills-touch := TouchArea {
                    clicked => { root.nav-selected("skills"); }
                }

                HorizontalLayout {
                    padding-left: AntigravityTheme.spacing-sm;
                    padding-right: AntigravityTheme.spacing-sm;
                    spacing: AntigravityTheme.spacing-sm;
                    alignment: start;

                    Text { text: "🧩"; font-size: 13px; vertical-alignment: center; }
                    Text {
                        text: "Skills & Customizations";
                        color: root.active-nav == "skills" ? AntigravityTheme.text-primary : AntigravityTheme.text-secondary;
                        font-size: 12px;
                        font-weight: root.active-nav == "skills" ? 700 : 500;
                        vertical-alignment: center;
                    }
                }
            }

            // 5. Models Hub Tab
            Rectangle {
                height: 34px;
                border-radius: AntigravityTheme.radius-sm;
                background: root.active-nav == "models" ? AntigravityTheme.background-active : (models-touch.has-hover ? AntigravityTheme.background-surface-hover : transparent);

                models-touch := TouchArea {
                    clicked => { root.nav-selected("models"); }
                }

                HorizontalLayout {
                    padding-left: AntigravityTheme.spacing-sm;
                    padding-right: AntigravityTheme.spacing-sm;
                    spacing: AntigravityTheme.spacing-sm;
                    alignment: start;

                    Text { text: "📦"; font-size: 13px; vertical-alignment: center; }
                    Text {
                        text: "Models Hub";
                        color: root.active-nav == "models" ? AntigravityTheme.text-primary : AntigravityTheme.text-secondary;
                        font-size: 12px;
                        font-weight: root.active-nav == "models" ? 700 : 500;
                        vertical-alignment: center;
                    }
                }
            }

            // 6. K-Top Telemetry Tab
            Rectangle {
                height: 34px;
                border-radius: AntigravityTheme.radius-sm;
                background: root.active-nav == "ktop" ? AntigravityTheme.background-active : (ktop-touch.has-hover ? AntigravityTheme.background-surface-hover : transparent);

                ktop-touch := TouchArea {
                    clicked => { root.nav-selected("ktop"); }
                }

                HorizontalLayout {
                    padding-left: AntigravityTheme.spacing-sm;
                    padding-right: AntigravityTheme.spacing-sm;
                    spacing: AntigravityTheme.spacing-sm;
                    alignment: start;

                    Text { text: "📊"; font-size: 13px; vertical-alignment: center; }
                    Text {
                        text: "K-Top Telemetry";
                        color: root.active-nav == "ktop" ? AntigravityTheme.text-primary : AntigravityTheme.text-secondary;
                        font-size: 12px;
                        font-weight: root.active-nav == "ktop" ? 700 : 500;
                        vertical-alignment: center;
                    }
                }
            }

            // 7. Settings Tab
            Rectangle {
                height: 34px;
                border-radius: AntigravityTheme.radius-sm;
                background: root.active-nav == "settings" ? AntigravityTheme.background-active : (settings-touch.has-hover ? AntigravityTheme.background-surface-hover : transparent);

                settings-touch := TouchArea {
                    clicked => { root.nav-selected("settings"); }
                }

                HorizontalLayout {
                    padding-left: AntigravityTheme.spacing-sm;
                    padding-right: AntigravityTheme.spacing-sm;
                    spacing: AntigravityTheme.spacing-sm;
                    alignment: start;

                    Text { text: "⚙️"; font-size: 13px; vertical-alignment: center; }
                    Text {
                        text: "Settings & Policies";
                        color: root.active-nav == "settings" ? AntigravityTheme.text-primary : AntigravityTheme.text-secondary;
                        font-size: 12px;
                        font-weight: root.active-nav == "settings" ? 700 : 500;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Divider
        Rectangle {
            height: 1px;
            background: AntigravityTheme.border-subtle;
        }

        Text {
            text: "RECENT SESSIONS";
            color: AntigravityTheme.text-muted;
            font-size: 10px;
            font-weight: 700;
        }

        // Session List
        VerticalLayout {
            spacing: AntigravityTheme.spacing-xs;
            vertical-stretch: 1;

            for session in root.sessions: Rectangle {
                height: 32px;
                border-radius: AntigravityTheme.radius-sm;
                background: s-touch.has-hover ? AntigravityTheme.background-surface-hover : transparent;

                s-touch := TouchArea {
                    clicked => { root.session-selected(session.id); }
                }

                HorizontalLayout {
                    padding-left: AntigravityTheme.spacing-sm;
                    padding-right: AntigravityTheme.spacing-sm;
                    alignment: space-between;

                    Text {
                        text: session.title;
                        color: AntigravityTheme.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                        width: 155px;
                    }

                    Text {
                        text: session.timestamp;
                        color: AntigravityTheme.text-muted;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
