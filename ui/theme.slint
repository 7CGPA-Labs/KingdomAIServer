// Kingdom AI Studio V3 - Google Antigravity Theme Tokens
export global AntigravityTheme {
    // Canvas & Surface Palette
    in-out property <color> background-canvas: #121316;
    in-out property <color> background-surface: #1a1d24;
    in-out property <color> background-surface-hover: #232731;
    in-out property <color> background-input: #15181e;
    in-out property <color> background-card: #1e222a;
    in-out property <color> background-active: #282d38;

    // Borders & Dividers
    in-out property <color> border-subtle: #2b303c;
    in-out property <color> border-strong: #3b4252;
    in-out property <color> border-focus: #26b5ce;

    // Typography
    in-out property <color> text-primary: #f3f4f6;
    in-out property <color> text-secondary: #9ca3af;
    in-out property <color> text-muted: #6b7280;
    in-out property <color> text-disabled: #4b5563;

    // Antigravity Accent Hues
    in-out property <color> accent-cyan: #26b5ce;
    in-out property <color> accent-magenta: #c084fc;
    in-out property <color> status-success: #22c55e;
    in-out property <color> status-warning: #eab308;
    in-out property <color> status-error: #ef4444;
    in-out property <color> status-info: #38bdf8;

    // Radii
    in-out property <length> radius-sm: 4px;
    in-out property <length> radius-md: 8px;
    in-out property <length> radius-lg: 12px;

    // Spacing scale
    in-out property <length> spacing-xs: 4px;
    in-out property <length> spacing-sm: 8px;
    in-out property <length> spacing-md: 12px;
    in-out property <length> spacing-lg: 16px;
    in-out property <length> spacing-xl: 24px;
}

export component ThemePreview inherits Window {
    background: AntigravityTheme.background-canvas;
    min-width: 100px;
    min-height: 100px;
}
